# Application configuration
APP_NAME=Bookstore Inventory API
ENVIRONMENT=development
LOG_LEVEL=INFO

# Neon pooled connection URL.
# Replace the placeholder with your actual Neon pooled connection details.
# The hostname must contain -pooler.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@YOUR-ENDPOINT-pooler.YOUR-REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require

# Neon direct connection URL.
# Replace the placeholder with your actual Neon direct connection details.
# The hostname must NOT contain -pooler.
MIGRATION_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@YOUR-ENDPOINT.YOUR-REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require

# Separate Neon branch or database reserved for automated tests.
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@YOUR-TEST-ENDPOINT-pooler.YOUR-REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require
